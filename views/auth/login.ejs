<%- include('../partials/head') %>

    <body>
        <div class="auth-wrapper">
            <div class="auth-card">

                <!-- ===== Left Panel ===== -->
                <div class="auth-left">
                    <div class="brand-logo">DesignHive</div>
                    <img src="/images/illustration.png" alt="DesignHive Illustration" class="illustration-img" />
                </div>

                <!-- ===== Right Panel ===== -->
                <div class="auth-right">
                    <h1 class="auth-title">Login</h1>

                    <form action="/login" method="POST" novalidate>

                        <!-- Email -->
                        <div class="form-group">
                            <label class="form-label" for="email">Email</label>
                            <div class="input-wrapper">
                                <span class="input-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <rect x="2" y="4" width="20" height="16" rx="2" />
                                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                                    </svg>
                                </span>
                                <div class="input-divider"></div>
                                <input type="email" id="email" name="email" placeholder="Enter your email"
                                    autocomplete="email" required />
                            </div>
                        </div>

                        <!-- Password -->
                        <div class="form-group">
                            <label class="form-label" for="password">Password</label>
                            <div class="input-wrapper">
                                <button type="button" class="eye-btn" id="togglePassword"
                                    aria-label="Toggle password visibility">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round" id="eyeIcon">
                                        <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                </button>
                                <div class="input-divider"></div>
                                <input type="password" id="password" name="password" placeholder="••••••••"
                                    autocomplete="current-password" required />
                            </div>
                        </div>

                        <!-- Forgot Password -->
                        <div class="forgot-row">
                            <a href="/forgot-password" class="forgot-link">Forgot Password?</a>
                        </div>

                        <!-- Submit -->
                        <button type="submit" class="btn-login">Log In</button>
                    </form>

                    <!-- Or Continue With -->
                    <div class="divider">Or Continue With</div>

                    <div class="social-row">
                        <!-- Google -->
                        <a href="#" class="social-btn" aria-label="Continue with Google">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
                                <path fill="#FFC107"
                                    d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34.5 6.5 29.5 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.2-.1-2.4-.4-3.5z" />
                                <path fill="#FF3D00"
                                    d="M6.3 14.7l6.6 4.8C14.5 16 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34.5 6.5 29.5 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
                                <path fill="#4CAF50"
                                    d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.3C29.3 35.3 26.8 36 24 36c-5.2 0-9.7-3.4-11.3-8H6.1c3.4 6.5 10.1 11 17.9 11z" />
                                <path fill="#1976D2"
                                    d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.3 4.1-4.3 5.5l6.2 5.3C41.4 35.5 44 30.1 44 24c0-1.2-.1-2.4-.4-3.5z" />
                            </svg>
                        </a>
                        <!-- Facebook -->
                        <a href="#" class="social-btn" aria-label="Continue with Facebook">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
                                <path fill="#1877F2"
                                    d="M48 24C48 10.7 37.3 0 24 0S0 10.7 0 24c0 11.9 8.7 21.8 20.1 23.7V31h-6v-7h6v-5.3c0-5.9 3.5-9.2 8.9-9.2 2.6 0 5.3.5 5.3.5V16h-3c-2.9 0-3.8 1.8-3.8 3.7V24h6.5l-1 7h-5.5v16.7C39.3 45.8 48 35.9 48 24z" />
                                <path fill="#fff"
                                    d="M33.3 31l1-7h-6.5v-4.3c0-1.9.9-3.7 3.8-3.7h3V10s-2.7-.5-5.3-.5c-5.4 0-8.9 3.3-8.9 9.2V24h-6v7h6v16.7c1.2.2 2.5.3 3.8.3s2.6-.1 3.8-.3V31h5.3z" />
                            </svg>
                        </a>
                        <!-- Apple -->
                        <a href="#" class="social-btn" aria-label="Continue with Apple">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#000">
                                <path
                                    d="M18.71 19.5C17.88 20.74 17 21.95 15.66 21.97C14.32 22 13.89 21.18 12.37 21.18C10.84 21.18 10.37 21.95 9.1 22C7.78 22.05 6.8 20.68 5.96 19.47C4.25 17 2.94 12.45 4.7 9.39C5.57 7.87 7.13 6.91 8.82 6.88C10.1 6.86 11.32 7.75 12.11 7.75C12.89 7.75 14.37 6.68 15.92 6.84C16.57 6.87 18.39 7.1 19.56 8.82C19.47 8.88 17.39 10.1 17.41 12.63C17.44 15.65 20.06 16.66 20.09 16.67C20.06 16.74 19.67 18.11 18.71 19.5ZM13 3.5C13.73 2.67 14.94 2.04 15.94 2C16.07 3.17 15.6 4.35 14.9 5.19C14.21 6.04 13.07 6.7 11.95 6.61C11.8 5.46 12.36 4.26 13 3.5Z" />
                            </svg>
                        </a>
                    </div>

                    <p class="signup-row">
                        Don't have an account? <a href="/signup">Sign Up here</a>
                    </p>
                </div>
            </div>
        </div>

        <!-- Flash Toasts Container -->
        <% if (typeof error !=='undefined' && error.length> 0) { %>
            <div class="flash-error">
                <%= error %>
            </div>
            <% } %>
                <% if (typeof success !=='undefined' && success.length> 0) { %>
                    <div class="flash-success">
                        <%= success %>
                    </div>
                    <% } %>

                        <script src="/js/auth.js"></script>
    </body>

    </html>