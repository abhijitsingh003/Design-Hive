<%- include('../partials/head') %>

    <body>
        <div class="auth-wrapper">
            <div class="auth-card">

                <!-- ===== Left Panel ===== -->
                <div class="auth-left">
                    <div class="brand-logo">DesignHive</div>
                    <img src="/images/illustration.png" alt="DesignHive Illustration" class="illustration-img" />
                </div>

                <!-- ===== Right Panel ===== -->
                <div class="auth-right">
                    <h1 class="auth-title">Sign Up</h1>

                    <form action="/signup" method="POST" novalidate>

                        <!-- Full Name -->
                        <div class="form-group">
                            <label class="form-label" for="name">Full Name</label>
                            <div class="input-wrapper">
                                <span class="input-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <circle cx="12" cy="8" r="4" />
                                        <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" />
                                    </svg>
                                </span>
                                <div class="input-divider"></div>
                                <input type="text" id="name" name="name" placeholder="Enter your full name"
                                    autocomplete="name" required />
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="form-group">
                            <label class="form-label" for="email">Email</label>
                            <div class="input-wrapper">
                                <span class="input-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <rect x="2" y="4" width="20" height="16" rx="2" />
                                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                                    </svg>
                                </span>
                                <div class="input-divider"></div>
                                <input type="email" id="email" name="email" placeholder="Enter your email"
                                    autocomplete="email" required />
                            </div>
                        </div>

                        <!-- Password -->
                        <div class="form-group">
                            <label class="form-label" for="password">Password</label>
                            <div class="input-wrapper">
                                <button type="button" class="eye-btn" id="togglePassword" aria-label="Toggle password">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round" id="eyeIcon1">
                                        <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                </button>
                                <div class="input-divider"></div>
                                <input type="password" id="password" name="password" placeholder="Min. 6 characters"
                                    autocomplete="new-password" required />
                            </div>
                        </div>

                        <!-- Confirm Password -->
                        <div class="form-group" style="margin-bottom: 28px;">
                            <label class="form-label" for="confirmPassword">Confirm Password</label>
                            <div class="input-wrapper">
                                <button type="button" class="eye-btn" id="toggleConfirm"
                                    aria-label="Toggle confirm password">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round" id="eyeIcon2">
                                        <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                </button>
                                <div class="input-divider"></div>
                                <input type="password" id="confirmPassword" name="confirmPassword"
                                    placeholder="Re-enter your password" autocomplete="new-password" required />
                            </div>
                        </div>

                        <!-- Submit -->
                        <button type="submit" class="btn-login">Create Account</button>
                    </form>


                    <p class="signup-row">
                        Already have an account? <a href="/login">Log In here</a>
                    </p>
                </div>
            </div>
        </div>

        <!-- Flash Toasts Container -->
        <% if (typeof error !=='undefined' && error.length> 0) { %>
            <div class="flash-error">
                <%= error %>
            </div>
            <% } %>
                <% if (typeof success !=='undefined' && success.length> 0) { %>
                    <div class="flash-success">
                        <%= success %>
                    </div>
                    <% } %>

                        <script src="/js/auth.js"></script>
    </body>

    </html>