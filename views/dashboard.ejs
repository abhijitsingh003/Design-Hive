<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard — DesignHive</title>
    <!-- Add custom tab icon -->
    <link rel="icon" type="image/jpeg" href="/images/Tab%20header%20img%20.jpg">
    <!-- Add Lucide icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/dashboard.css?v=<%= Date.now() %>">
</head>

<body>
    <!-- Top Navigation -->
    <nav class="top-nav">
        <div class="nav-container nav-container-full">
            <a href="#" class="brand-logo"
                onclick="window.scrollTo({top: 0, behavior: 'smooth'}); return false;">DesignHive</a>
            <div class="nav-right">
                <a href="/logout" class="btn-logout">
                    <i data-lucide="log-out" width="18" height="18"></i>
                    Log Out
                </a>
            </div>
        </div>
    </nav>



    <!-- Main Feed -->
    <main class="feed-container">

        <h2 class="feed-greeting">Hello, <span class="highlight-name">
                <%= userName.split(' ')[0] %></span> <span class="wave">👋</span></h2>

        <!-- Create Post Card -->
        <div class="card create-post-card">
            <div class="card-header">
                <div class="avatar">
                    <%= userName.charAt(0).toUpperCase() %>
                </div>
                <div class="create-post-title">Create a Post</div>
            </div>
            <form action="/posts" method="POST" enctype="multipart/form-data" class="post-form">
                <div class="input-area">
                    <textarea name="content" placeholder="What' s on your mind, <%=userName %>?" rows="3"></textarea>

                    <!-- Media Preview Container -->
                    <div id="image-preview-container" class="image-preview-wrapper" style="display: none;">
                        <img id="image-preview" src="" alt="Selected preview" class="preview-img"
                            style="display: none;">
                        <video id="video-preview" src="" controls class="preview-img" style="display: none;"></video>
                        <button type="button" id="remove-image-btn" class="btn-remove-preview">
                            <i data-lucide="x" width="14" height="14"></i>
                        </button>
                    </div>
                    </div>
                    <div class="form-actions">
                        <label class="btn-upload tooltip-container">
                            <div class="icon-wrapper">
                                <i data-lucide="image" width="24" height="24"></i>
                                <span class="badge-plus"><i data-lucide="plus" width="10" height="10"></i></span>
                            </div>
                            <span class="tooltip">Add media</span>
                            <input type="file" name="image" id="imageInput" accept="image/*,video/*"
                                style="display: none;">
                        </label>
                        <button type="submit" class="btn-primary">Post</button>
                    </div>
                    </form>
                    </div>

                    <!-- Posts List -->
                    <% if (posts && posts.length> 0) { %>
                        <% posts.forEach(post=> { %>
                            <div class="card post-card">
                                <div class="post-header">
                                    <div class="post-author-info">
                                        <div class="avatar">
                                            <%= post.user.name.charAt(0).toUpperCase() %>
                                        </div>
                                        <div>
                                            <h3 class="author-name">
                                                <%= post.user.name %>
                                            </h3>
                                            <div class="post-time">
                                                <%= new Date(post.createdAt).toLocaleString(undefined, {
                                                    dateStyle: 'medium' , timeStyle: 'short' }) %>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Options for owner only -->
                                    <% if (post.user._id.toString()===userId) { %>
                                        <div class="post-options">
                                            <button class="btn-icon"
                                                onclick="toggleDropdown('dropdown-<%= post._id %>')">
                                                <i data-lucide="more-horizontal"></i>
                                            </button>
                                            <div class="dropdown-menu" id="dropdown-<%= post._id %>">
                                                <!-- Use forms with method override for PUT/DELETE -->
                                                <form action="/posts/<%= post._id %>?_method=PUT" method="POST"
                                                    class="edit-form-inner" style="display:none;"
                                                    id="edit-form-<%= post._id %>">
                                                    <textarea name="content"><%= post.content %></textarea>
                                                    <div class="edit-actions">
                                                        <button type="button" class="btn-text"
                                                            onclick="toggleEdit('<%= post._id %>')">Cancel</button>
                                                        <button type="submit" class="btn-primary-small">Save</button>
                                                    </div>
                                                </form>

                                                <button class="dropdown-item" onclick="toggleEdit('<%= post._id %>')">
                                                    <i data-lucide="edit-2" width="16" height="16"></i> Edit Post
                                                </button>

                                                <form action="/posts/<%= post._id %>?_method=DELETE" method="POST"
                                                    onsubmit="return confirm('Are you sure you want to delete this post?');">
                                                    <button type="submit" class="dropdown-item danger">
                                                        <i data-lucide="trash-2" width="16" height="16"></i> Delete
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                        <% } %>
                                </div>

                                <div class="post-content" id="content-<%= post._id %>">
                                    <span class="post-text-inner">
                                        <%= post.content %>
                                    </span>
                                </div>

                                <% if (post.image) { %>
                                    <div class="post-image">
                                        <% if (post.image.match(/\.(mp4|webm|ogg|mov|avi|wmv|flv)$/i)) { %>
                                            <video controls
                                                style="width: 100%; max-height: 500px; display: block; object-fit: cover;">
                                                <source src="<%= post.image %>" type="video/mp4">
                                                Your browser does not support the video tag.
                                            </video>
                                            <% } else { %>
                                                <img src="<%= post.image %>" alt="Post attachment">
                                                <% } %>
                                    </div>
                                    <% } %>

                                        <div class="post-footer">
                                            <button class="btn-action like-btn" onclick="toggleLike(this)"
                                                data-liked="false">
                                                <i data-lucide="heart"></i>
                                                <span>Like</span>
                                            </button>
                                            <button class="btn-action"><i data-lucide="message-square"></i>
                                                Comment</button>
                                            <button class="btn-action"><i data-lucide="share-2"></i> Share</button>
                                        </div>
                            </div>
                            <% }) %>

                                <!-- Pagination -->
                                <div class="pagination">
                                    <% if (currentPage> 1) { %>
                                        <a href="/dashboard?page=<%= currentPage - 1 %>"
                                            class="btn-pagination">Previous</a>
                                        <% } else { %>
                                            <span class="btn-pagination disabled">Previous</span>
                                            <% } %>

                                                <span class="page-info">Page <%= currentPage %> of <%= totalPages %>
                                                </span>

                                                <% if (currentPage < totalPages) { %>
                                                    <a href="/dashboard?page=<%= currentPage + 1 %>"
                                                        class="btn-pagination">Next</a>
                                                    <% } else { %>
                                                        <span class="btn-pagination disabled">Next</span>
                                                        <% } %>
                                </div>

                                <% } else { %>
                                    <div class="empty-state">
                                        <i data-lucide="layers" width="48" height="48"></i>
                                        <h2>No Posts Yet</h2>
                                        <p>Be the first to share something with the hive!</p>
                                    </div>
                                    <% } %>

    </main>

    <!-- Flash Toasts Container -->
    <% if (typeof error !=='undefined' && error.length> 0) { %>
        <div class="flash-error">
            <%= error %>
        </div>
        <% } %>
            <% if (typeof success !=='undefined' && success.length> 0) { %>
                <div class="flash-success">
                    <%= success %>
                </div>
                <% } %>

                    <script src="/js/dashboard.js?v=<%= Date.now() %>"></script>
</body>

</html>